# =========================================================
# FSJA Horarios — variables de entorno (specs/02-architecture-plan.md §5.7)
# Copia este archivo a `.env` y rellena los valores. `.env` nunca se sube al repositorio.
# Las variables secretas se dejan VACÍAS a propósito: genera valores aleatorios, por ejemplo con
#   openssl rand -base64 48
# Este archivo es un esqueleto (T1.2). T1.4 lo completa y lo valida con Zod en el arranque.
# =========================================================

# --- Aplicación web ---------------------------------------
# Entorno: development | test | production
APP_ENV=development
# Origen público de la web, para la comprobación de `Origin` (CSRF)
APP_ORIGIN=http://localhost:3000
# Nº de proxies de confianza delante de la web (0 en local; 1 tras el proxy inverso)
TRUSTED_PROXY_HOPS=0
# Clave HMAC (>= 32 bytes aleatorios) para seudonimizar correos en el rate limiting
RATE_LIMIT_KEY_SECRET=

# --- Base de datos ----------------------------------------
POSTGRES_USER=fsja
POSTGRES_DB=fsja
POSTGRES_PASSWORD=
# Formato: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=

# --- Solver -----------------------------------------------
SOLVER_URL=http://solver:8000
# Token compartido web <-> solver (>= 32 bytes aleatorios)
SOLVER_SERVICE_TOKEN=
# Trabajos de cálculo simultáneos
SOLVER_MAX_CONCURRENT_JOBS=1

# --- Datos de demostración (nunca en producción) ----------
# true para cargar el seed al arrancar (se rechaza si APP_ENV=production)
SEED_ON_START=false
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=
SEED_TEACHER_EMAIL=docente@demo.local
SEED_TEACHER_PASSWORD=
SEED_GUEST_EMAIL=invitado@demo.local
SEED_GUEST_PASSWORD=
