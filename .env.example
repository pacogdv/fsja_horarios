# =========================================================
# FSJA Horarios — variables de entorno (specs/02-architecture-plan.md §5.7)
#
# Copia este archivo a `.env` (Docker Compose) y a `apps/web/.env.local` (`pnpm dev`, porque Next.js lee
# los .env de su propia carpeta). Los `.env` reales nunca se suben al repositorio.
#
# Las variables secretas se dejan VACÍAS a propósito: genera valores aleatorios con
#   openssl rand -base64 48
# La web valida todas estas variables al arrancar (apps/web/src/lib/env.ts) y no arranca si alguna es
# inválida. Los mensajes de error nombran la variable, nunca su valor.
# =========================================================

# --- Aplicación web ---------------------------------------
# Entorno de ejecución. Formato: development | test | production.
APP_ENV=development
# Origen público de la web, para la comprobación de `Origin` (CSRF). Formato: http(s)://host[:puerto],
# sin ruta ni barra final. En production debe usar https.
APP_ORIGIN=http://localhost:3000
# Nº de proxies inversos de confianza delante de la web, para obtener la IP real del cliente.
# Formato: entero de 0 a 3 (0 en local; 1 tras el proxy inverso de producción). Por defecto: 0.
TRUSTED_PROXY_HOPS=0
# Clave HMAC para seudonimizar correos en las claves de rate limiting. SECRETO: >= 32 caracteres aleatorios.
RATE_LIMIT_KEY_SECRET=

# --- Base de datos ----------------------------------------
# Usuario que crea el contenedor de PostgreSQL al inicializarse (servicio db).
POSTGRES_USER=fsja
# Base de datos que crea el contenedor de PostgreSQL al inicializarse (servicio db).
POSTGRES_DB=fsja
# Contraseña del usuario de PostgreSQL (servicio db). SECRETO.
POSTGRES_PASSWORD=
# Conexión de la web a PostgreSQL. SECRETO (contiene la contraseña).
# Formato: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=

# --- Solver -----------------------------------------------
# URL interna del solver, accesible solo desde la red de Docker. Formato: http(s)://host:puerto.
SOLVER_URL=http://solver:8000
# Token compartido web <-> solver (cabecera Authorization: Bearer). SECRETO: >= 32 caracteres aleatorios.
SOLVER_SERVICE_TOKEN=
# Trabajos de cálculo simultáneos en el solver. Formato: entero >= 1. Por defecto: 1.
SOLVER_MAX_CONCURRENT_JOBS=1

# --- Datos de demostración (nunca en producción) ----------
# Carga el centro de demostración al arrancar. Formato: true | false. Por defecto: false.
# Se rechaza si APP_ENV=production (TFM-02). Con true, las seis variables SEED_* son obligatorias.
SEED_ON_START=false
# Correo del usuario demo con rol ADMIN_DIRECCION. Formato: correo electrónico.
SEED_ADMIN_EMAIL=admin@demo.local
# Contraseña del usuario demo ADMIN_DIRECCION. SECRETO: >= 12 caracteres.
SEED_ADMIN_PASSWORD=
# Correo del usuario demo con rol DOCENTE. Formato: correo electrónico.
SEED_TEACHER_EMAIL=docente@demo.local
# Contraseña del usuario demo DOCENTE. SECRETO: >= 12 caracteres.
SEED_TEACHER_PASSWORD=
# Correo del usuario demo con rol INVITADO_DEMO. Formato: correo electrónico.
SEED_GUEST_EMAIL=invitado@demo.local
# Contraseña del usuario demo INVITADO_DEMO. SECRETO: >= 12 caracteres.
SEED_GUEST_PASSWORD=
